# Optional: override the app URL (default is http://127.0.0.1:3000 in playwright.config.ts).
# Use a deployed preview or production only when you intentionally run tests against it.
# BASE_URL=https://fakefolio.vercel.app

# When using Supabase-backed auth in E2E (not required for localStorage-only flows),
# set credentials via CI secrets or a local untracked file — never commit real passwords.
# E2E_TEST_USER_EMAIL=
# E2E_TEST_USER_PASSWORD=
